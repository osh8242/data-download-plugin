<idea-plugin>
    <id>com.github.osh8242.datadownload</id>
    <name>Dataset Downloader for DataGrip</name>
    <vendor email="osh8242@naver.com" url="https://github.com/osh8242">osh8242</vendor>

    <description><![CDATA[
    DataGrip plugin to download datasets as CSV/XLSX using database connection profiles.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Persistent Config Storage -->
        <projectService serviceImplementation="com.github.plugin.datadownload.config.DataDownloadConfig"/>
        
        <!-- ToolWindow on the right side -->
        <toolWindow id="Data Downloader" 
                    anchor="right" 
                    factoryClass="com.github.plugin.datadownload.ui.DataDownloadToolWindowFactory"
                    icon="AllIcons.Actions.Download"/>
    </extensions>

    <actions>
        <!-- Actions are handled programmatically within the ToolWindow -->
    </actions>
</idea-plugin>
